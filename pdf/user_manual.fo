                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title2"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Controls</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 2 - <!--content(text)--><fo:inline>Controls</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 2 - <!--content(text)--><fo:inline>Controls</fo:inline></fo:marker><fo:inline>2. </fo:inline><fo:inline>Controls</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Use the pedal’s
                                    control knobs to shape how your signal is compressed. </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                    <fo:block>
                                        <fo:inline space-start="40px" space-end="40px"><fo:inline-container vertical-align="top" width="45%"><fo:block-container margin="0" font-size="0pt" role="Figure" id="unique_2_Connect_42_fig_ldr_dhf_3kc" chfox:nd-id="fig_ldr_dhf_3kc"><fo:block end-indent="0" start-indent="0"><fo:inline chfox:inch="true" max-width="100%" width="100%" id="unique_2_Connect_42_image_mdr_dhf_3kc" chfox:nd-id="image_mdr_dhf_3kc"><fo:inline><fo:external-graphic src="file:/Users/levpullynen/Documents/oxygen%20projects/user-manual/images/controls.svg" fox:alt-text="M87 Bass Compressor Controls" max-width="100%" scaling="uniform" width="100%" content-width="scale-to-fit"/></fo:inline></fo:inline></fo:block></fo:block-container></fo:inline-container></fo:inline>
                                        <fo:inline><fo:inline-container vertical-align="top" width="45%"><fo:block-container margin="0"><fo:block end-indent="0" start-indent="0">
                                            <fo:block>
                                                <fo:table-and-caption border-collapse="collapse" id="unique_2_Connect_42_simpletable_xh1_2xg_3kc" space-before="1em" space-after="1em"><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" border-bottom-color="black" border-bottom-width="2pt" border-bottom-style="none" border-left-color="black" border-left-width="2pt" border-left-style="none" border-right-color="black" border-right-width="2pt" border-right-style="none" border-top-color="black" border-top-width="2pt" border-top-style="none" hyphenate="true" chfox:nd-id="simpletable_xh1_2xg_3kc" space-before="0" space-after="0"><fo:table-column column-width="10%"/><fo:table-column column-width="90%"/><fo:table-body display-align="before">
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>A</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>The <fo:inline font-weight="bold">GAIN
                                                  REDUCTION</fo:inline> meter shows the level of
                                                  compression applied in real time. If it doesn't
                                                  light up, it means that the input signal has not
                                                  reached the fixed threshold for compression.</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>B</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>The <fo:inline font-weight="bold">RELEASE</fo:inline> knob controls how quickly
                                                  compression stops after the signal falls back
                                                  down.</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>C</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>The <fo:inline font-weight="bold">ATTACK</fo:inline> knob controls how quickly
                                                  compression is applied after a note is
                                                  played.</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>D</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>The <fo:inline font-weight="bold">RATIO</fo:inline> determines how strongly the signal
                                                  is compressed once it exceeds the threshold. </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>E</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>The <fo:inline font-weight="bold">OUTPUT</fo:inline> knob controls the overall volume
                                                  of the signal coming out of the pedal. The <fo:inline font-weight="bold">OUT</fo:inline> 1/4" jack on the side of the pedal
                                                  connects to an amplifier or other pedals with an
                                                  instrument cable.</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>F</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>The <fo:inline font-weight="bold">INPUT</fo:inline> knob controls the gain of initial
                                                  signal coming out of your guitar. The <fo:inline font-weight="bold">IN</fo:inline> 1/4" jack on the side of the pedal
                                                  connects to the guitar with an instrument
                                                  cable.</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>G</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>The light indicator shows whether the pedal is on
                                                  or off.</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="0" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>H</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="0" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>The footswitch toggles the pedal on or off. </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-body></fo:table></fo:table-and-caption>
                                            </fo:block>
                                        </fo:block></fo:block-container></fo:inline-container></fo:inline>
                                    </fo:block>
                                </fo:block></fo:block-container>
                            </fo:block></fo:block-container>
