ents/oxygen%20projects/user-manual/images/mxr-logo-black.svg')" background-repeat="no-repeat" background-position="50% 50%"><fo:block> </fo:block></fo:block-container><fo:block-container width="1in" height="(8.5in - 1in - 1in)"><fo:block/></fo:block-container><!--BOTTOM-LEFT-CORNER--><fo:block-container width="1in" height="1in" margin="0"><fo:block/></fo:block-container></fo:static-content><fo:static-content flow-name="sc-end-right" role="artifact"><!--TOP-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0"><fo:block/></fo:block-container><fo:block-container width="1in" height="(8.5in - 1in - 1in)"><fo:block/></fo:block-container><!--BOTTOM-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:page-number/></fo:block></fo:block-container></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_1" chfox:nd-id="description"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title1"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Description</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 1 - <!--content(text)--><fo:inline>Description</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 1 - <!--content(text)--><fo:inline>Description</fo:inline></fo:marker><fo:inline>1. </fo:inline><fo:inline>Description</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">MXR M87 Bass
                                    Compressor is a compressor pedal for bass guitar.</fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_1_Connect_42_section_u1q_lgn_3kc" chfox:nd-id="section_u1q_lgn_3kc"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e460" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">About
                                        compression</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">In audio
                                        engineering, the compression effect allows you to
                                        dynamically control the difference between the loudest and
                                        quietest parts of an audio signal. </fo:block></fo:block-container>
                                    <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">In terms of bass guitar, a dedicated
                                        compressor effect can:<fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_1_Connect_42_ul_sgq_h1n_3kc" chfox:nd-id="ul_sgq_h1n_3kc">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Improve the volume consistency of played
                                                notes.</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Increase the sustain of the notes.</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Make
                                                the quieter nuances more audible in the mix.</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Control the sharp peaks from slaps and pops when
                                                playing with the slapping technique. </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Help
                                                you shape the distorted tone by raising certain
                                                frequencies more.</fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block></fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">In general, all
                                        compressors have at least four basic controls: </fo:block></fo:block-container>
                                    <fo:block id="unique_1_Connect_42_dl_fdh_cdn_3kc" chfox:nd-id="dl_fdh_cdn_3kc">
                                        <fo:block-container font-weight="700" space-after="0.5em" margin-left="1em" margin-right="1em" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Threshold</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="3em" margin-right="3em" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The volume
                                            above which the compression begins.</fo:block></fo:block-container>
                                        <fo:block-container font-weight="700" space-after="0.5em" margin-left="1em" margin-right="1em" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Ratio</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="3em" margin-right="3em" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The
                                            strength of the compression; the higher the ratio, the
                                            more dB is reduced from the input above the
                                            threshold.</fo:block></fo:block-container>
                                        <fo:block-container font-weight="700" space-after="0.5em" margin-left="1em" margin-right="1em" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Attack</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="3em" margin-right="3em" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The time
                                            it takes for the compressor to start reducing the signal
                                            after it exceeds the threshold.</fo:block></fo:block-container>
                                        <fo:block-container font-weight="700" space-after="0.5em" margin-left="1em" margin-right="1em" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Release</fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="3em" margin-right="3em" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The time
                                            the compression lasts after it initially reducing the
                                            signal.</fo:block></fo:block-container>
                                    </fo:block>
                                </fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-start-left-first-blank" role="artifact"><!--TOP-LEFT-CORNER--><fo:block-container width="1in" height="1in" margin="0" fox:background-image-width="50 * 1in div 100" background-position-horizontal="50%" background-position-vertical="50%" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif" background-image="url('file:/Users/levpullynen/Documents/oxygen%20projects/user-manual/images/mxr-logo-black.svg')" background-repeat="no-repeat" background-position="50% 50%"><fo:block> </fo:block></fo:block-container><fo:block-container width="1in" height="(8.5in - 1in - 1in)"><fo:block/></fo:block-container><!--BOTTOM-LEFT-CORNER--><fo:block-container width="1in" height="1in" margin="0"><fo:block/></fo:block-container></fo:static-content><fo:static-content flow-name="sc-end-left-first-blank" role="artifact"><!--TOP-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0"><fo:block/></fo:block-container><fo:block-container width="1in" height="(8.5in - 1in - 1in)"><fo:block/></fo:block-container><!--BOTTOM-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:page-number/></fo:block></fo:block-container></fo:static-content><fo:static-content flow-name="sc-start-left-first" role="artifact"><!--TOP-LEFT-CORNER--><fo:block-container width="1in" height="1in" margin="0" fox:background-image-width="50 * 1in div 100" background-position-horizontal="50%" background-position-vertical="50%" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif" backgr