><fo:block/></fo:block-container></fo:static-content><fo:static-content flow-name="sc-end-right-blank" role="artifact"><!--TOP-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0"><fo:block/></fo:block-container><fo:block-container width="1in" height="(8.5in - 1in - 1in)"><fo:block/></fo:block-container><!--BOTTOM-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:page-number/></fo:block></fo:block-container></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(11.0in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-start-right" role="artifact"><!--TOP-LEFT-CORNER--><fo:block-container width="1in" height="1in" margin="0" fox:background-image-width="50 * 1in div 100" background-position-horizontal="50%" background-position-vertical="50%" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif" background-image="url('file:/Users/levpullynen/Documents/oxygen%20projects/user-manual/images/mxr-logo-black.svg')" background-repeat="no-repeat" background-position="50% 50%"><fo:block> </fo:block></fo:block-container><fo:block-container width="1in" height="(8.5in - 1in - 1in)"><fo:block/></fo:block-container><!--BOTTOM-LEFT-CORNER--><fo:block-container width="1in" height="1in" margin="0"><fo:block/></fo:block-container></fo:static-content><fo:static-content flow-name="sc-end-right" role="artifact"><!--TOP-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0"><fo:block/></fo:block-container><fo:block-container width="1in" height="(8.5in - 1in - 1in)"><fo:block/></fo:block-container><!--BOTTOM-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:page-number/></fo:block></fo:block-container></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_4" chfox:nd-id="first_start"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title4"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>First start</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 4 - <!--content(text)--><fo:inline>First start</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 4 - <!--content(text)--><fo:inline>First start</fo:inline></fo:marker><fo:inline>4. </fo:inline><fo:inline>First start</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">This is a basic
                                    workflow with the compressor as your only pedal. </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_4_Connect_42_prereq_wqp_djs_3kc" chfox:nd-id="prereq_wqp_djs_3kc"><fo:block end-indent="0" start-indent="0">Before you begin, make sure the
                                    pedal has <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="The pedal requires 9V DC power to operate." internal-destination="unique_3">power</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text="The pedal requires 9V DC power to operate." internal-destination="unique_3"><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_3"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_3"><fo:page-number-citation ref-id="unique_3"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_3">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>. </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">Starting from basic settings, try to
                                    experiment with all the knobs to get an effect you
                                    enjoy.</fo:block></fo:block-container>
                                <fo:block role="Sect">
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Plug in the cable from your
                                                guitar into the <fo:inline font-weight="bold">IN</fo:inline> jack input.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Run a different cable from the
                                                pedal's <fo:inline font-weight="bold">OUT</fo:inline> jack to your amplifier or audio
                                                interface.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:inline>You can start off with the
                                                following settings on the pedal:</fo:inline>
                                            <fo:block>
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="0em" space-before="0em" id="unique_4_Connect_42_ol_uzx_h4g_3kc" chfox:nd-id="ol_uzx_h4g_3kc">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">a. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:inline font-weight="bold">RELEASE</fo:inline>, <fo:inline font-weight="bold">ATTACK</fo:inline>, <fo:inline font-weight="bold">OUTPUT</fo:inline>, and <fo:inline font-weight="bold">INPUT</fo:inline> knobs at 12 o'clock. </fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">b. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:inline font-weight="bold">RATIO</fo:inline> at 4 o'clock.</fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                                <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="unique_4_Connect_42_fig_ppq_b4g_3kc" chfox:nd-id="fig_ppq_b4g_3kc"><fo:block end-indent="0" start-indent="0"><fo:inline chfox:inch="true" height="150px" max-width="100%" id="unique_4_Connect_42_image_qpq_b4g_3kc" chfox:nd-id="image_qpq_b4g_3kc"><fo:inline><fo:external-graphic src="file:/Users/levpullynen/Documents/oxygen%20projects/user-manual/images/basic-settings.svg" fox:alt-text="Basic settings" max-width="100%" scaling="uniform" height="150px" content-height="scale-to-fit"/></fo:inline></fo:inline></fo:block></fo:block-container>
                                            </fo:block>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Press the footswitch to turn on
                                                the pedal. </fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:inline>Looking at the <fo:inline font-weight="bold">GAIN
                                                  REDUCTION</fo:inline> meter, rotate the <fo:inline font-weight="bold">INPUT</fo:inline> knob so that you see a range from
                                                3 to 7 lights on the meter while playing your guitar
                                                normally: </fo:inline>
                                            <fo:block>
                                                <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="unique_4_Connect_42_fig_i3z_5mg_3kc" chfox:nd-id="fig_i3z_5mg_3kc"><fo:block end-indent="0" start-indent="0"><fo:inline chfox:inch="true" max-width="100%" id="unique_4_Connect_42_image_j3z_5mg_3kc" chfox:nd-id="image_j3z_5mg_3kc"><fo:inline><fo:external-graphic src="file:/Users/levpullynen/Documents/oxygen%20projects/user-manual/images/basic-gain-reduction.svg" fox:alt-text="Basic gain reduction" max-width="100%" content-width="scale-to-fit"/></fo:inline></fo:inline></fo:block></fo:block-container>
                                            </fo:block>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">6. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Rotate the <fo:inline font-weight="bold">OUTPUT</fo:inline> knob to the desired overall
                                                volume.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">7. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Rotate the <fo:inline font-weight="bold">ATTACK</fo:inline> knob clockwise to soften the
                                                initial attack of your note or counterclockwise to
                                                accentuate it. </fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">8. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Rotate the <fo:inline font-weight="bold">RELEASE</fo:inline> knob clockwise to make the
                                                compression effect last longer or counterclockwise
                                                to make it fade faster.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">9. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Use the <fo:inline font-weight="bold">RATIO</fo:inline> knob to define the strength of
                                                compression. The bigger the setting (up to 20:1),
                                                the more volume will be decreased when compression
                                                is in effect. For example, the 4:1 setting means
                                                that, for every 4dB over the threshold, only 1dB
                                                comes through.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                </fo:block>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_4_Connect_42_result_pch_mqs_3kc" chfox:nd-id="result_pch_mqs_3kc"><fo:block end-indent="0" start-indent="0">Once you have dialed in the
                                    compression, you can start playing as-is or add other effects
                                    after the compressor in your signal chain.</fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-start-left-first-blank" role="artifact"><!--TOP-LEFT-CORNER--><fo:block-container width="1in" height="1in" margin="0" fox:background-image-width="50 * 1in div 100" background-position-horizontal="50%" background-position-vertical="50%" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif" background-image="url('file:/Users/levpullynen/Documents/oxygen%20projects/user-manual/images/mxr-logo-black.svg')" background-repeat="no-repeat" background-position="50% 50%"><fo:block> </fo:block></fo:block-container><fo:block-container width="1in" height="(8.5in - 1in - 1in)"><fo:block/></fo:block-container><!--BOTTOM-LEFT-CORNER--><fo:block-container width="1in" height="1in" margin="0"><fo:block/></fo:block-container></fo:static-content><fo:static-content flow-name="sc-end-left-first-blank" role="artifact"><!--TOP-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0"><fo:block/></fo:block-container><fo:block-container width="1in" height="(8.5in - 1in - 1in)"><fo:block/></fo:block-container><!--BOTTOM-RIGHT-CORNER--><fo:block-container width="1in" height="1in" margin="0" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:page-number/></fo:block></fo:block-container></fo:static-content><fo:static-content flow-name="sc-start-left-first" role="artifact"><!--TOP-LEFT-CORNER--><fo:block-container width="1in" height="1in" margin="0" fox:background-image-width="50 * 1in div 100" background-position-horizontal="50%" background-position-vertical="50%" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif" backgr