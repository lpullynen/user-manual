                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title3"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Power</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 3 - <!--content(text)--><fo:inline>Power</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 3 - <!--content(text)--><fo:inline>Power</fo:inline></fo:marker><fo:inline>3. </fo:inline><fo:inline>Power</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">The pedal requires
                                    9V DC power to operate.</fo:block></fo:block-container>
                                <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">You can power the pedal in two ways:<fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>A standard
                                            9V battery. Remove the bottom lid of the pedal with a
                                            screwdriver to install the battery.</fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>A 9V AC/DC
                                            adapter. Connect it either to a standard AC wall socket
                                            or a compatible power supply. Plug the power connector
                                            into the power jack next to the <fo:inline font-weight="bold">IN</fo:inline> jack for the
                                            instrument. </fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block></fo:block></fo:block-container>
                                <fo:block>
                                    <fo:inline space-start="40px" space-end="40px"><fo:inline-container vertical-align="top" width="45%"><fo:block-container margin="0" font-size="0pt" role="Figure" id="unique_3_Connect_42_fig_w5r_3ym_3kc" chfox:nd-id="fig_w5r_3ym_3kc"><fo:block end-indent="0" start-indent="0"><fo:inline chfox:inch="true" max-width="100%" width="100%" id="unique_3_Connect_42_image_gs2_gnm_3kc" chfox:nd-id="image_gs2_gnm_3kc"><fo:inline><fo:external-graphic src="file:/Users/levpullynen/Documents/oxygen%20projects/user-manual/images/side-profile.svg" max-width="100%" scaling="uniform" width="100%" content-width="scale-to-fit"/></fo:inline></fo:inline></fo:block></fo:block-container></fo:inline-container></fo:inline>
                                    <fo:inline><fo:inline-container vertical-align="top" width="45%"><fo:block-container margin="0"><fo:block end-indent="0" start-indent="0">
                                        <fo:block>
                                            <fo:table-and-caption border-collapse="collapse" id="unique_3_Connect_42_simpletable_ijp_jym_3kc" space-before="1em" space-after="1em"><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" border-bottom-color="black" border-bottom-width="2pt" border-bottom-style="none" border-left-color="black" border-left-width="2pt" border-left-style="none" border-right-color="black" border-right-width="2pt" border-right-style="none" border-top-color="black" border-top-width="2pt" border-top-style="none" hyphenate="true" chfox:nd-id="simpletable_ijp_jym_3kc" space-before="0" space-after="0"><fo:table-column column-width="10%"/><fo:table-column column-width="90%"/><fo:table-body display-align="before">
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>A</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>9V DC center-negative power jack.</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row display-align="before">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="0" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="1px" font-weight="bold" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" text-align="center"><fo:block>B</fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="0" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>1/4" jack for the instrument cable. Labeled
                                                  <fo:inline font-weight="bold">IN</fo:inline> on the front plate.</fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                </fo:table-body></fo:table></fo:table-and-caption>
                                        </fo:block>
                                    </fo:block></fo:block-container></fo:inline-container></fo:inline>
                                </fo:block>
